{
  "name": "ourin-remake-baileys",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "argo-codec": "^0.2.1",
    "async-mutex": "^0.5.0",
    "libsignal": "^6.0.0",
    "link-preview-js": "^3.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "ws": "^8.20.1",
    "long": "^5.3.2",
    "@types/ws": "^8.18.1",
    "@types/node": "^22.13.14"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.1"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    }
  },
  "version": "2.0.0",
  "description": "Unified Ourin WhatsApp library with a single runtime and public entry point",
  "license": "SEE LICENSE IN LICENSES.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellpigi/Ourin-MD-Remake.git"
  },
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.cts",
    "index.d.mts",
    "bot.cjs",
    "README.md",
    "LICENSES.txt",
    "test.cjs"
  ],
  "scripts": {
    "preinstall": "node -e \"const [m,n]=process.versions.node.split('.').map(Number);if(m<22||(m===22&&n<12)){console.error('Use Node.js >=22.12.0');process.exit(1)}\"",
    "start": "node bot.cjs",
    "test": "node --test test.cjs"
  }
}
